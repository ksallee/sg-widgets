---
/**
 * One lockup: a type treatment, at one size, with a mark in front of it or without one.
 *
 * Both treatments are the same two words in the same face and the same weight split --
 * SG medium, Widgets regular -- and differ only in what carries the colour. Colours are
 * tokens, so a treatment is judged under whichever palette and theme the page wears, and
 * the mark is sized in `em`, so it scales with the type. The word carrying the plain ink
 * takes it from `currentColor`, which is `--foreground` on the page and
 * `--sidebar-foreground` on the nav strip, so a lockup holds on either ground.
 *
 * `size` is any CSS length. The page passes the size Starlight gives the site title and a
 * display size.
 */
import WordmarkMark from './WordmarkMark.astro';
import type { MarkTake, TypeTreatment } from './wordmark-variants';

interface Props {
  /** An `id` from typeTreatments. */
  treatment: TypeTreatment['id'];
  /** An `id` from markTakes. Without one the type stands alone. */
  mark?: MarkTake['id'];
  size: string;
}

const { treatment, mark, size } = Astro.props;
---

<span class="lockup" style={`font-size:${size}`}>
  {mark && <WordmarkMark mark={mark} size="1.15em" />}

  {
    treatment === 'muted-tail' && (
      <span>
        <span class="font-medium">SG</span> <span class="font-normal text-muted-foreground">Widgets</span>
      </span>
    )
  }

  {
    treatment === 'primary-head' && (
      <span>
        <span class="font-medium text-primary">SG</span> <span class="font-normal">Widgets</span>
      </span>
    )
  }
</span>

<style>
  /* The lockup owns the space between a mark and the type; the space between the two
     words is a word space, so it stays a typographic one at every size. */
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    line-height: 1.1;
    white-space: nowrap;
  }
</style>
