---
/**
 * A design harness, not a docs page: the second round of the site title, narrowed to two
 * marks and two type treatments and pushed further. It sits outside Starlight and outside
 * the sidebar, and nothing links to it.
 *
 * Each mark take is shown at a display size and at favicon sizes, each type treatment at
 * the size Starlight gives the site title and at the display size, and the last section
 * pairs every take with every treatment. Both grounds a title has to hold -- the page and
 * the nav strip -- carry every one of them. Everything is drawn from tokens, so the three
 * controls at the top redress the whole page at once.
 */
import '../../styles/global.css';
import Wordmark from '../../components/Wordmark.astro';
import WordmarkMark from '../../components/WordmarkMark.astro';
import { markSizes, markTakes, typeTreatments } from '../../components/wordmark-variants';
import { palettes, radii } from '../../components/demo-prefs';

/*
 * The palette and the radius on `:root` before the first paint, the same script the
 * Starlight pages inline in their head. Read as text, not run as a module: it is the head
 * entry, not something the page imports. This page is outside Starlight, so it also has to
 * write light and dark itself; the second inline script below does that.
 */
import paletteBoot from '../../scripts/palette-boot.js?raw';

/* Starlight sizes the site title at `--sl-text-h4`, which is `--sl-text-2xl` above 50rem. */
const HEADER_SIZE = 'var(--sl-text-2xl)';
const DISPLAY_SIZE = 'var(--sl-text-6xl)';

/*
 * The two grounds a title has to hold. Each hands the marks on it its own background
 * token, so the gap that lifts a front tile off a back one is the colour behind it.
 */
const grounds = [
  { id: 'page', label: 'Page', surface: 'bg-background text-foreground', ground: '--mark-ground: var(--background)' },
  { id: 'nav', label: 'Nav', surface: 'bg-sidebar text-sidebar-foreground', ground: '--mark-ground: var(--sidebar)' },
];

const tileTakes = markTakes.filter((take) => take.family === 'tiles');
const slateTakes = markTakes.filter((take) => take.family === 'slate');

const markSections = [
  {
    id: 'tiles',
    title: 'Stacked tiles',
    intro:
      'Two tiles, a widget on a widget. The inner square is gone: every tile is one flat shape, and the front one is lifted off the back one by a gap in the colour behind the mark.',
    takes: tileTakes,
  },
  {
    id: 'slate',
    title: 'Slate bars',
    intro: 'The clapper, taken past two rectangles. Each take stays geometric and is judged at 16px first.',
    takes: slateTakes,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>SG Widgets: wordmark round two</title>
    <script is:inline set:html={paletteBoot} />
    <script is:inline>
      /* Light and dark before the first paint. Starlight's own theme script is not here. */
      (() => {
        let raw = null;
        try {
          raw = localStorage.getItem('sg-demo:theme') ?? localStorage.getItem('starlight-theme');
        } catch {
          raw = null; // Blocked storage: the light theme is the fallback everywhere.
        }
        try {
          const parsed = JSON.parse(raw);
          if (typeof parsed === 'string') raw = parsed;
        } catch {
          /* A raw string is the common spelling; keep it. */
        }
        document.documentElement.dataset.theme = raw === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>

  <body class="sg-demo min-h-screen bg-background text-foreground">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 p-6">
      <header class="flex flex-col gap-3">
        <h1 class="text-2xl font-medium">SG Widgets: wordmark round two</h1>
        <p class="max-w-prose text-sm text-muted-foreground">
          Two marks taken further and two type treatments, then every pairing of the two. Nothing here is
          a decision; it is the material for one. No third-party logo or brand asset is reproduced.
        </p>

        <div class="flex flex-wrap items-center gap-2">
          <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
            Palette
            <select
              data-palette-pick
              class="h-8 rounded-md border border-border bg-background px-2 text-sm text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {palettes.map((palette) => <option value={palette.name}>{palette.label}</option>)}
            </select>
          </label>

          <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
            Radius
            <select
              data-radius-pick
              class="h-8 rounded-md border border-border bg-background px-2 text-sm text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {radii.map((radius) => <option value={radius.name}>{radius.label}</option>)}
            </select>
          </label>

          <button
            type="button"
            data-theme-toggle
            aria-pressed="false"
            class="h-8 rounded-md border border-border bg-background px-3 text-sm font-medium text-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            Dark
          </button>
        </div>
      </header>

      {
        markSections.map((section) => (
          <section class="flex flex-col gap-3" data-mark-section={section.id}>
            <h2 class="text-sm font-medium">{section.title}</h2>
            <p class="max-w-prose text-xs text-muted-foreground">{section.intro}</p>

            <div class="grid gap-4 lg:grid-cols-2">
              {section.takes.map((take) => (
                <article
                  class="flex flex-col overflow-hidden rounded-lg border border-border"
                  data-take={take.id}
                >
                  <div class="flex flex-col gap-1 bg-card px-4 py-3">
                    <h3 class="text-sm font-medium text-card-foreground" data-take-label>
                      {take.label}
                    </h3>
                    <p class="text-xs text-muted-foreground">{take.note}</p>
                  </div>

                  <div class="grid gap-px border-t border-border bg-border">
                    {grounds.map((ground) => (
                      <div
                        class={`flex flex-col gap-3 p-4 ${ground.surface}`}
                        style={ground.ground}
                        data-ground={ground.id}
                      >
                        <span class="text-xs text-muted-foreground">{ground.label}</span>
                        <div class="flex items-end gap-6">
                          <span class="flex flex-col items-center gap-1.5" data-mark-size="display">
                            <WordmarkMark mark={take.id} size={DISPLAY_SIZE} />
                            <span class="text-xs text-muted-foreground">display</span>
                          </span>
                          {markSizes.map((px) => (
                            <span class="flex flex-col items-center gap-1.5" data-mark-size={px}>
                              <WordmarkMark mark={take.id} size={`${px}px`} />
                              <span class="text-xs tabular-nums text-muted-foreground">{px}</span>
                            </span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <section class="flex flex-col gap-3">
        <h2 class="text-sm font-medium">Type treatments</h2>
        <p class="max-w-prose text-xs text-muted-foreground">
          Both keep the weight split, SG medium and Widgets regular, and change only what carries the
          colour.
        </p>

        <div class="grid gap-4 lg:grid-cols-2">
          {
            typeTreatments.map((treatment) => (
              <article
                class="flex flex-col overflow-hidden rounded-lg border border-border"
                data-treatment={treatment.id}
              >
                <div class="flex flex-col gap-1 bg-card px-4 py-3">
                  <h3 class="text-sm font-medium text-card-foreground" data-treatment-label>
                    {treatment.label}
                  </h3>
                  <p class="text-xs text-muted-foreground">{treatment.note}</p>
                </div>

                <div class="grid gap-px border-t border-border bg-border">
                  {grounds.map((ground) => (
                    <div
                      class={`flex flex-col gap-3 p-4 ${ground.surface}`}
                      style={ground.ground}
                      data-ground={ground.id}
                    >
                      <span class="text-xs text-muted-foreground">{ground.label}</span>
                      <div class="flex flex-wrap items-center gap-6">
                        <span class="flex items-center" data-size="display">
                          <Wordmark treatment={treatment.id} size={DISPLAY_SIZE} />
                        </span>
                        <span class="flex items-center" data-size="header">
                          <Wordmark treatment={treatment.id} size={HEADER_SIZE} />
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="text-sm font-medium">Combinations</h2>
        <p class="max-w-prose text-xs text-muted-foreground">
          Every mark take beside every treatment, at the header size. Each cell is the page ground over
          the nav strip.
        </p>

        <div class="grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-[9rem_1fr_1fr]">
          <div class="bg-card px-3 py-2" />
          {
            typeTreatments.map((treatment) => (
              <div class="bg-card px-3 py-2 text-xs font-medium text-card-foreground">{treatment.label}</div>
            ))
          }

          {
            markTakes.map((take) => (
              <>
                <div class="flex items-center bg-card px-3 py-2 text-xs font-medium text-card-foreground">
                  {take.label}
                </div>
                {typeTreatments.map((treatment) => (
                  <div class="grid gap-px bg-border" data-cell={`${take.id}:${treatment.id}`}>
                    {grounds.map((ground) => (
                      <div class={`px-3 py-2.5 ${ground.surface}`} style={ground.ground} data-ground={ground.id}>
                        <Wordmark treatment={treatment.id} mark={take.id} size={HEADER_SIZE} />
                      </div>
                    ))}
                  </div>
                ))}
              </>
            ))
          }
        </div>
      </section>
    </div>

    <script>
      /**
       * The three controls, on the same `sg-demo:*` keys the docs site uses, so
       * `tools/qa.mjs` dresses this page with `--palette` and `--dark` without clicking.
       * `applyPrefs` puts the palette and the radius on `:root`; light and dark is
       * Starlight's `data-theme`, which nothing else writes on a page outside Starlight.
       */
      import { applyPrefs, prefs, setPref, togglePref, watchPrefs } from '../../components/demo-prefs';

      function sync(): void {
        document.documentElement.dataset.theme = prefs.theme;

        const palettePick = document.querySelector<HTMLSelectElement>('[data-palette-pick]');
        if (palettePick) palettePick.value = prefs.palette;

        const radiusPick = document.querySelector<HTMLSelectElement>('[data-radius-pick]');
        if (radiusPick) radiusPick.value = prefs.radius;

        document
          .querySelector('[data-theme-toggle]')
          ?.setAttribute('aria-pressed', String(prefs.theme === 'dark'));
      }

      applyPrefs();
      watchPrefs();
      sync();

      // `watchPrefs` reads the keys back on `storage`; this puts the result on the page.
      window.addEventListener('storage', sync);

      document.addEventListener('change', (event) => {
        const target = event.target as HTMLElement | null;
        if (target?.matches('[data-palette-pick]')) setPref('palette', (target as HTMLSelectElement).value);
        if (target?.matches('[data-radius-pick]')) setPref('radius', (target as HTMLSelectElement).value);
        sync();
      });

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        togglePref('theme');
        sync();
      });
    </script>
  </body>
</html>
