{
  "name": "sg-widgets",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check": "pnpm registry:check && pnpm --filter sg-widgets-core build && pnpm -r check",
    "registry:check": "node tools/registry-check.mjs",
    "registry:build": "pnpm registry:check && pnpm -r registry:build",
    "dev:site": "pnpm --filter site dev",
    "qa": "node tools/qa.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
