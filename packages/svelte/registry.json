        "@sg-widgets/core",
        "@lucide/svelte"
      ],
      "registryDependencies": [
        "local:field-picker",
        "badge",
        "skeleton"
      ],
      "files": [
        {
          "path": "src/lib/registry/components/column-picker.svelte",
          "type": "registry:component"
        }
      ]
    }
