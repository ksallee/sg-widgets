---
/**
 * One mark take, drawn from tokens alone.
 *
 * Fills are `--primary` or `currentColor`, so a mark wears the palette and the theme
 * around it, and every corner is a fraction of `--radius`, so the radius switch reaches
 * the mark: at radius none every tile is square, at xl every tile is a disc. The `rx`
 * attributes are the value the CSS below overrides, for a browser that does not take the
 * geometry properties as CSS.
 *
 * A tile that sits on top of another is parted by a gap in `--mark-ground`, which the
 * surface under the mark sets to its own background token. Nothing inside a tile draws a
 * second shape.
 *
 * `size` is any CSS length and is the box side.
 */
import type { MarkTake } from './wordmark-variants';

interface Props {
  /** An `id` from markTakes. */
  mark: MarkTake['id'];
  size?: string;
}

const { mark, size = '1em' } = Astro.props;
const box = `width:${size};height:${size}`;
---

{
  mark === 'tiles-tight' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile ink-dim" x="2" y="2" width="23" height="23" rx="4" />
      <rect class="tile accent knock" x="15" y="15" width="23" height="23" rx="4" />
    </svg>
  )
}

{
  mark === 'tiles-generous' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile ink-dim" x="2" y="2" width="21" height="21" rx="4" />
      <rect class="tile accent knock" x="17" y="17" width="21" height="21" rx="4" />
    </svg>
  )
}

{
  mark === 'tiles-back-accent' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile accent" x="2" y="2" width="23" height="23" rx="4" />
      <rect class="tile ink knock" x="15" y="15" width="23" height="23" rx="4" />
    </svg>
  )
}

{
  mark === 'tiles-mono' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile ink-dim" x="2" y="2" width="23" height="23" rx="4" />
      <rect class="tile ink knock" x="15" y="15" width="23" height="23" rx="4" />
    </svg>
  )
}

{
  mark === 'tiles-popover' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile ink-dim" x="1.5" y="1.5" width="25" height="25" rx="4" />
      <rect class="tile accent knock" x="17" y="17" width="21" height="21" rx="4" />
    </svg>
  )
}

{
  mark === 'slate-hinge' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="bar ink" x="7" y="24.5" width="29" height="10.5" rx="2" />
      <rect class="bar ink-mid" x="7" y="9.5" width="29" height="10" rx="2" transform="rotate(-14 9.5 22)" />
      <circle class="accent" cx="9.5" cy="22" r="4.4" />
    </svg>
  )
}

{
  mark === 'slate-rows' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="bar accent" x="5" y="5" width="30" height="8" rx="2" />
      <rect class="bar ink-mid" x="5" y="16" width="23" height="8" rx="2" />
      <rect class="bar ink-faint" x="5" y="27" width="16" height="8" rx="2" />
    </svg>
  )
}

{
  mark === 'slate-progress' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="bar ink-dim" x="4" y="5" width="32" height="9" rx="2" />
      <rect class="bar accent" x="4" y="5" width="19" height="9" rx="2" />
      <rect class="tile ink-mid" x="4" y="17" width="32" height="18" rx="4" />
    </svg>
  )
}

<style>
  .mark {
    display: block;
    flex: none;
    /* Each shape's corner is a fraction of the token, so a tile and a bar keep their
       own proportion while both follow the radius switch. */
    --tile-radius: calc(var(--radius) * 0.5);
    --bar-radius: calc(var(--radius) * 0.28);
  }

  .tile {
    rx: var(--tile-radius);
    ry: var(--tile-radius);
  }

  .bar {
    rx: var(--bar-radius);
    ry: var(--bar-radius);
  }

  .accent {
    fill: var(--primary);
  }

  .ink {
    fill: currentColor;
  }

  /* A palette where `--primary` sits on `--foreground` would flatten a mark, so the quiet
     shapes are set apart by weight rather than by a second colour. */
  .ink-mid {
    fill: currentColor;
    opacity: 0.85;
  }

  .ink-faint {
    fill: currentColor;
    opacity: 0.55;
  }

  .ink-dim {
    fill: currentColor;
    opacity: 0.3;
  }

  /* The gap that lifts the front tile off the back one. `paint-order` puts the fill over
     the inner half of the stroke, so the whole gap falls outside the tile and the tile
     keeps its size. */
  .knock {
    /* The surface under the mark sets `--mark-ground` to its own background token; the
       fallback is the page. Declaring it here instead would outrank what the surface
       inherits down. */
    stroke: var(--mark-ground, var(--background));
    stroke-width: 2.2;
    paint-order: stroke;
  }
</style>
