---
/**
 * Themes: paste a shadcn theme, see the widgets wearing it, keep it as the palette every
 * page wears, and copy it back out with the three status roles the widgets need.
 *
 * The page sits outside Starlight, like the QA lab, because the editor wants the window
 * rather than the docs column. Starlight's header takes no props and reads route data
 * this page has none of, so the bar below carries the palette select, a light/dark
 * toggle written against the key Starlight's own select holds, and the link back to the
 * docs.
 *
 * One preview column, at the 50rem the docs column reads at, so a demo here stands at
 * the width it stands at on its widget page. The toggle in the bar switches its mode,
 * and the editor adjusts the mode on show. The demos are the ones a theme shows in
 * first: status, a table, a picker, an editor and a card.
 */
import '../styles/global.css';
import Demo from '../components/Demo.astro';
import SiteControls from '../components/SiteControls.astro';
import Wordmark from '../components/Wordmark.astro';
import ThemeEditor from './_themes/ThemeEditor.tsx';

const demos = [
  {
    name: 'entity-table',
    title:
      'Entity Table: 320 Versions in pages of 25, with a filter bar, a column picker and a sort picker in the toolbar. Pages, Load more and Scroll switch how the set is walked. An editable cell lights up under the pointer; a double-click or Enter opens its editor in a popover; Popover editor and Inline editor switch where every editor opens.',
  },
  { name: 'filter-bar', title: 'FilterBar: status, sequence and shot type over Shot, seeded pills, read state over Note, and sizes' },
  { name: 'filter-editor', title: 'FilterEditor: a catalogue of Version filters, one group per data type, with its serialised filter, a Note read-state row, and sizes' },
  { name: 'field-editor', title: 'FieldEditor: every data type, with a display and edit toggle' },
  {
    name: 'entity-picker',
    title: 'EntityPicker: secondary column, types, project scope, hydration, paging, errors, row anatomy, sizes, states',
  },
  { name: 'entity-card', title: 'EntityCard: three sizes from a row, one card reading a picked reference, and the tile variant' },
  {
    name: 'status-badge',
    title: 'StatusBadge: neutral and coloured, the bare glyph on the muted ground and on its colour, removable, labels, stock icons, unknown codes',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Themes</title>
    <meta name="description" content="Paste a shadcn theme, see the widgets wearing it, and take it away with its status roles." />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Starlight's key, so the mode this page is left in is the mode the docs open in.
      try {
        const stored = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body class="bg-background text-foreground">
    <header class="th-bar">
      <div class="th-home">
        <a href="/widgets/"><Wordmark /></a>
        <h1 class="th-title">Themes</h1>
      </div>
      <div class="th-controls">
        <SiteControls />
        <button class="th-toggle" type="button" data-theme-toggle aria-pressed="false">Dark</button>
      </div>
    </header>

    <div class="th-page sg-demo">
      <aside class="th-side">
        <ThemeEditor client:only="react" />
      </aside>

      <main class="th-preview">
        <section class="th-column">
          {demos.map((demo) => <Demo name={demo.name} title={demo.title} />)}
        </section>
      </main>
    </div>

    <script>
      /** The page's own light/dark, on the key Starlight's select holds. */
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      function paint(): void {
        const dark = root.dataset.theme === 'dark';
        root.classList.toggle('dark', dark);
        root.style.colorScheme = dark ? 'dark' : 'light';
        toggle?.setAttribute('aria-pressed', String(dark));
        if (toggle) toggle.textContent = dark ? 'Light' : 'Dark';
      }

      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          // The mode holds for this page either way.
        }
        paint();
      });

      paint();
    </script>

    <style is:global>
      /* The page's own chrome, in plain CSS on the tokens. The stage reset starts below the
       * bar: the palette select is Starlight's, and the reset would strip its padding. */
      body { margin: 0; font-family: var(--font-sans); line-height: 1.5; -webkit-font-smoothing: antialiased; }
      .th-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--border);
        background: var(--background);
      }
      .th-home { display: flex; align-items: center; gap: 0.75rem; font-size: 1.125rem; }
      .th-home a { display: inline-flex; align-items: center; color: var(--foreground); text-decoration: none; }
      .th-title { margin: 0; color: var(--muted-foreground); font-size: 0.875rem; font-weight: 500; }
      .th-controls { display: flex; align-items: center; gap: 1rem; }
      .th-toggle {
        height: 2rem;
        font: inherit;
        background: transparent;
        cursor: pointer;
        padding: 0 0.75rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) * 0.8);
        color: var(--foreground);
        font-size: 0.8125rem;
      }
      .th-toggle:hover { background: var(--accent); color: var(--accent-foreground); }
      .th-toggle:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px var(--ring); }

      .th-page { display: grid; grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); align-items: start; }
      .th-side {
        position: sticky;
        top: 0;
        max-height: 100vh;
        overflow-y: auto;
        border-right: 1px solid var(--border);
        background: var(--background);
      }
      .th-preview { min-width: 0; padding: 1.5rem; }
      /* The docs column's own width, centred in the room left beside the editor. */
      .th-column { display: flex; flex-direction: column; gap: 1rem; min-width: 0; max-width: 50rem; margin-inline: auto; }
      @media (max-width: 75rem) {
        .th-page { grid-template-columns: minmax(0, 1fr); }
        .th-side { position: static; max-height: none; border-right: 0; border-bottom: 1px solid var(--border); }
      }
      @media (max-width: 40rem) {
        .th-bar { flex-wrap: wrap; padding: 0.75rem 1rem; }
        .th-preview { padding: 1rem; }
      }

      .th-editor { display: flex; flex-direction: column; font-size: 0.875rem; }
      .th-lead { padding: 1rem 1rem 0; color: var(--muted-foreground); font-size: 0.8125rem; }
      .th-lead a { color: var(--foreground); text-decoration: underline; text-underline-offset: 2px; }
      .th-group { display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem; border-bottom: 1px solid var(--border); }
      .th-h { font-size: 0.875rem; font-weight: 600; }
      .th-label, .th-value, .th-ratio { color: var(--muted-foreground); font-size: 0.75rem; }
      .th-role { text-transform: capitalize; }
      .th-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .th-ratio[data-fail] { color: var(--destructive); }
      .th-field { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
      .th-two { display: grid; grid-template-columns: 6rem minmax(0, 1fr); align-items: center; gap: 0.5rem; }
      .th-inline { display: grid; grid-template-columns: 6rem 2rem minmax(0, 1fr) auto; align-items: center; gap: 0.5rem; }
      .th-slider { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 4rem; align-items: center; gap: 0.5rem; }
      .th-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
      .th-between { justify-content: space-between; }
      .th-error { color: var(--destructive); font-size: 0.75rem; }

      .th-in {
        width: 100%;
        min-width: 0;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--input);
        border-radius: calc(var(--radius) * 0.8);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
        font-size: 0.8125rem;
      }
      .th-in:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px var(--ring); }
      .th-paste { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.75rem; resize: vertical; }
      .th-color { width: 2rem; height: 1.75rem; padding: 0; border: 1px solid var(--border); border-radius: calc(var(--radius) * 0.6); background: transparent; }
      .th-range { -webkit-appearance: none; appearance: none; width: 100%; height: 0.5rem; border-radius: 999px; background: var(--muted); }
      .th-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 1rem;
        height: 1rem;
        border: 2px solid var(--foreground);
        border-radius: 50%;
        background: var(--background);
        cursor: pointer;
      }
      .th-range::-moz-range-thumb { width: 1rem; height: 1rem; border: 2px solid var(--foreground); border-radius: 50%; background: var(--background); cursor: pointer; }
      .th-range:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--background), 0 0 0 4px var(--ring); }
      .th-out {
        max-height: 14rem;
        padding: 0.75rem;
        overflow: auto;
        border: 1px solid var(--input);
        border-radius: var(--radius);
        background: var(--muted);
        color: var(--foreground);
        font-size: 0.6875rem;
        line-height: 1.5;
        white-space: pre;
      }
    </style>
  </body>
</html>
