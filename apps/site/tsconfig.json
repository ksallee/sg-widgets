{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Mirrors the Vite aliases in astro.config.mjs so demo islands typecheck against
    // the registry sources in the workspace packages.
    "paths": {
      "@/*": ["../../packages/react/src/*"],
      "@base-ui/react": ["../../packages/react/node_modules/@base-ui/react"],
      "bits-ui": ["../../packages/svelte/node_modules/bits-ui"],
      "$lib": ["../../packages/svelte/src/lib/index.ts"],
      "$lib/*": ["../../packages/svelte/src/lib/*"],
      "@sg-widgets/core": ["../../packages/core/src/index.ts"],
      "@sg-widgets/core/mock": ["../../packages/core/src/mock.ts"]
    }
  }
}
