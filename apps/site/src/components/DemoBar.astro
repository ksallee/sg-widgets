---
/**
 * The site's control bar: one strip under the header that drives every demo on the page.
 *
 * Framework, palette, radius, light/dark and reduced motion shape the demo stages; Mock
 * or Live, the site, the login and the project choose what the widgets read. Every
 * control writes a `sg-demo:*` key, so a choice made here holds for the demos below it,
 * for the next page, and for a second tab.
 *
 * The bar wears the shadcn tokens through `sg-demo-chrome`, which follows Starlight's
 * light and dark theme: this is docs chrome, not a demo stage, and the palette a
 * reviewer picks never reaches it.
 */
import { palettes, radii } from './demo-prefs';

const control =
  'inline-flex h-8 items-center justify-center px-2 text-sm text-muted-foreground select-none ' +
  'transition-[color,background-color,opacity,transform] duration-150 ease-out ' +
  'hover:bg-accent hover:text-accent-foreground ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background ' +
  'active:scale-[0.98] ' +
  'aria-pressed:bg-accent aria-pressed:text-accent-foreground aria-pressed:font-medium';

const segmentClass = `${control} border-l border-border first:border-l-0`;
const toggleClass = `${control} rounded-md border border-border bg-background`;
const groupClass = 'inline-flex h-8 items-center overflow-hidden rounded-md border border-border bg-background';

// The native chevron is not a token, so it is drawn from `currentColor` alongside.
const inputClass =
  'h-8 w-64 max-w-full rounded-md border border-border bg-background px-2 text-sm text-foreground ' +
  'placeholder:text-muted-foreground ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const selectWrapClass = 'group relative inline-flex items-center text-muted-foreground';
const selectClass = `${toggleClass} appearance-none pr-7`;
const chevronClass =
  'pointer-events-none absolute right-2 size-4 transition-colors duration-150 ease-out ' +
  'group-hover:text-accent-foreground';
---

<section
  class="sg-demo sg-demo-chrome sg-demo-bar flex flex-wrap items-center gap-3 border-b border-border bg-muted px-4 py-2"
  aria-label="Demo controls"
  data-sg-bar
  data-source="mock"
>
  <div class={groupClass} role="group" aria-label="Framework">
    <button type="button" class={segmentClass} data-framework-pick="svelte" aria-pressed="false">
      Svelte
    </button>
    <button type="button" class={segmentClass} data-framework-pick="react" aria-pressed="false">
      React
    </button>
    <button type="button" class={segmentClass} data-framework-pick="both" aria-pressed="true">
      Both
    </button>
  </div>

  <span class={selectWrapClass}>
    <select class={selectClass} data-palette-pick aria-label="Theme">
      {palettes.map((palette) => <option value={palette.name}>{palette.label}</option>)}
    </select>
    <svg
      class={chevronClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </span>

  <span class={selectWrapClass}>
    <select class={selectClass} data-radius-pick aria-label="Radius">
      {radii.map((radius) => <option value={radius.name}>{radius.label}</option>)}
    </select>
    <svg
      class={chevronClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </span>

  <button type="button" class={toggleClass} data-theme-toggle aria-pressed="false">Dark</button>
  <button type="button" class={toggleClass} data-motion-toggle aria-pressed="false">Reduce motion</button>

  <span class="h-6 w-px bg-border" aria-hidden="true"></span>

  <div class={groupClass} role="group" aria-label="Data source">
    <button type="button" class={segmentClass} data-source-pick="mock" aria-pressed="true">Mock</button>
    <button type="button" class={segmentClass} data-source-pick="live" aria-pressed="false">Live</button>
  </div>

  <div class="flex min-w-0 flex-wrap items-center gap-2" data-live-bar data-live-state="anon">
    <input
      type="url"
      class={inputClass}
      data-live-site
      aria-label="Site url"
      placeholder="https://your-studio.shotgrid.autodesk.com"
    />
    <button type="button" class={toggleClass} data-live-login>Log in</button>
    <span class="min-w-0 max-w-xs truncate text-xs text-muted-foreground" data-live-status></span>
    <button type="button" class={toggleClass} data-live-logout>Log out</button>
    <div class="w-64" data-live-project></div>
  </div>
</section>

<script>
  /**
   * Wires the bar. The demos apply the same keys themselves, so the bar hands its
   * changes to `applyPrefs` rather than reaching into a stage.
   */
  import { applyPrefs, setPref, togglePref, watchPrefs } from './demo-prefs';
  import { mountLiveControls } from './demo-live';

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('[data-sg-bar]')) return;

    const pick = target.closest<HTMLElement>('[data-framework-pick]');
    if (pick?.dataset.frameworkPick) setPref('framework', pick.dataset.frameworkPick);
    else if (target.closest('[data-theme-toggle]')) togglePref('theme');
    else if (target.closest('[data-motion-toggle]')) togglePref('motion');
  });

  document.addEventListener('change', (event) => {
    const select = (event.target as HTMLElement | null)?.closest<HTMLSelectElement>('select');
    if (!select?.closest('[data-sg-bar]')) return;

    if (select.matches('[data-palette-pick]')) setPref('palette', select.value);
    else if (select.matches('[data-radius-pick]')) setPref('radius', select.value);
  });

  applyPrefs();
  watchPrefs();
  void mountLiveControls();
</script>

<style>
  /* Layout only; every colour, radius and spacing value above comes from a token. */
  .sg-demo-bar {
    position: sticky;
    /* Under the fixed header, and under the mobile table of contents where it shows. */
    top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    z-index: 3;
  }

  /* The site, login and project controls belong to live mode alone. */
  [data-sg-bar]:not([data-source='live']) [data-live-bar] {
    display: none;
  }

  [data-live-bar]:not([data-live-state='anon']) [data-live-login],
  [data-live-bar]:not([data-live-state='in']) [data-live-logout],
  [data-live-bar][data-live-state='anon'] [data-live-project] {
    display: none;
  }
</style>
