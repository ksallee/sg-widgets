{
  "name": "sg-widgets",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check": "pnpm -r check",
    "registry:build": "pnpm -r registry:build",
    "dev:site": "pnpm --filter site dev"
  }
}
