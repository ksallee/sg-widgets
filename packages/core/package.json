{
  "name": "@sg-widgets/core",
  "version": "0.0.1",
  "description": "Headless, framework-agnostic model of Flow Production Tracking (ShotGrid) fields, filters, statuses and a client adapter, for building widgets.",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://sg-widgets.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksallee/sg-widgets.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mock": {
      "types": "./dist/mock.d.mts",
      "import": "./dist/mock.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/mock.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "prepare": "tsdown src/index.ts src/mock.ts --format esm --dts"
  },
  "license": "MIT",
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
