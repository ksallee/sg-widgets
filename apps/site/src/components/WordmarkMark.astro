---
/**
 * One candidate mark, drawn from tokens alone.
 *
 * Fills are `--primary`, `--muted` or `currentColor`, so a mark wears the palette and
 * the light/dark theme around it, and every corner is a fraction of `--radius`, so the
 * radius switch reaches the mark: at radius none every tile is square, at xl every tile
 * is a disc. The `rx` attributes are the value the CSS below overrides, for a browser
 * that does not take the geometry properties as CSS.
 *
 * `size` is any CSS length. The square marks take it as their box; the bracketed one is
 * type, so it takes it as its font size.
 */
import type { WordmarkMarkId } from './wordmark-variants';

interface Props {
  mark: WordmarkMarkId;
  /** Box side for the drawn marks, font size for the bracketed one. */
  size?: string;
}

const { mark, size = '1em' } = Astro.props;
const box = `width:${size};height:${size}`;
---

{
  mark === 'stacked-tiles' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile outline" x="2.25" y="2.25" width="21.5" height="21.5" rx="5" />
      <rect class="tile solid" x="16" y="16" width="22" height="22" rx="5" />
    </svg>
  )
}

{
  mark === 'tile-grid' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="tile dim" x="1" y="1" width="17" height="17" rx="5" />
      <rect class="tile solid" x="22" y="1" width="17" height="17" rx="5" />
      <rect class="tile dim" x="1" y="22" width="17" height="17" rx="5" />
      <rect class="tile dim" x="22" y="22" width="17" height="17" rx="5" />
    </svg>
  )
}

{
  mark === 'bracket-sg' && (
    <span class="bracket font-mono font-medium" style={`font-size:${size}`} aria-hidden="true">
      <span class="text-muted-foreground">[</span>SG<span class="text-muted-foreground">]</span>
    </span>
  )
}

{
  mark === 'slate-bars' && (
    <svg class="mark" style={box} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect class="bar dim" x="2" y="15" width="36" height="23" rx="3" />
      <rect class="bar solid" x="3" y="3.5" width="34" height="9" rx="3" transform="rotate(-5 20 8)" />
    </svg>
  )
}

<style>
  .mark {
    display: block;
    flex: none;
    /* Each shape's corner is a fraction of the token, so a tile and a bar keep their
       own proportion while both follow the radius switch. */
    --tile-radius: calc(var(--radius) * 0.5);
    --bar-radius: calc(var(--radius) * 0.28);
  }

  .tile {
    rx: var(--tile-radius);
    ry: var(--tile-radius);
  }

  .bar {
    rx: var(--bar-radius);
    ry: var(--bar-radius);
  }

  .solid {
    fill: var(--primary);
  }

  /* A palette where `--primary` sits on top of `--foreground` would flatten the mark, so
     the quiet shapes are set apart by weight rather than by a second colour. */
  .dim {
    fill: currentColor;
    opacity: 0.28;
  }

  .outline {
    fill: var(--muted);
    stroke: currentColor;
    stroke-width: 2.5;
  }

  .bracket {
    line-height: 1;
    white-space: nowrap;
  }
</style>
