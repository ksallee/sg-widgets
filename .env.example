# Copy to .env.local. The monorepo keeps one, at this root, and apps/site reads it
# (`envDir` in apps/site/astro.config.mjs).

# The site the Connect panel offers, and the one the live demos read.
PUBLIC_FPT_SITE_URL=

# The script key /live/dev-token mints a bearer from, so `pnpm qa --live` reaches the
# site without a person clicking approve. Dev only; never in a build.
FPT_API_SITE_URL=
FPT_API_SCRIPT_NAME=
FPT_API_API_KEY=

# 1 brings back the demo toolbar's Both segment, the `both` framework value, the
# two-pane stage and the wider column those panes need. A published page shows one
# framework, so leave it unset outside development. `pnpm qa --framework both` needs it.
PUBLIC_SG_DEMO_BOTH=
